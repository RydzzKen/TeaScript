// Contoh: membaca konfigurasi dari file .env (tanpa paket Python tambahan).
// Jalankan dari folder yang punya file .env:
//   tea examples/env.tea
//
// Isi .env contoh:
//   NAMA=Ken
//   PORT=8080
//   DEBUG=true

import env

let ok = env.load()
if not ok {
  print("(file .env tidak ditemukan — pakai nilai default)")
}

let nama = env.get("NAMA", "tanpa nama")
let port = env.get_num("PORT", 5000)
let debug = env.get_bool("DEBUG", false)

print("Nama  :", nama)
print("Port  :", port, "| tipe:", type(port))
print("Debug :", debug, "| tipe:", type(debug))

// Variabel dari OS juga terbaca.
print("HOME  :", env.get("HOME"))

// wajib(...) berhenti dengan pesan jelas kalau variabel tidak ada.
// print(env.wajib("WAJIB_ADA"))

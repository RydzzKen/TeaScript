// String — interpolasi, slicing, ternary, dan builtin string
let nama = "Ken"
let sapaan = "Halo, ${nama}!"

print(sapaan)
print("Panjang:", len(sapaan))
print("5 pertama:", sapaan[0:5])
print("Dari belakang:", sapaan[-4:])
print("Besar:", upper(nama))
print("Kata:", join(split("saya suka teh", " "), " | "))
print("Status:", len(nama) > 3 ? "panjang" : "pendek")

// Gaya method (seperti Python/JS) — hasilnya bisa dirantai
print("---")
print(sapaan.trim().upper())
print("a,b,c".split(","))
print("  tepi  ".trim())
print("halo dunia".title())
print("a-b-c".replace("-", "+"))
print("halo".startswith("ha"), "halo".endswith("lo"))
print("abc".find("c"), "abc".count("a"), "42".isdigit())
print(",".join(["satu", "dua"]).upper())
print("abc".reverse(), "7".zfill(3))

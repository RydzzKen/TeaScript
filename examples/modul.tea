// Import modul — stdlib TeaScript dengan gaya Python
import math
import text
from collections import sum, reverse

print("sqrt(2)    :", math.sqrt(2))
print("pow(2, 10) :", math.pow(2, 10))
print("round(3.6) :", math.round(3.6))
print("clamp(15)  :", math.clamp(15, 0, 10))

print("capitalize :", text.capitalize("halo dunia"))
print("title      :", text.title("selamat datang di teascript"))
print("replace    :", text.replace_all("a-b-c", "-", " + "))

print("sum        :", sum([1, 2, 3, 4]))
print("reverse    :", reverse([1, 2, 3]))

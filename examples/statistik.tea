// Statistik sederhana — fungsi, loop, dan builtin angka
fn total(xs) {
  let sum = 0
  for x in xs {
    sum += x
  }
  return sum
}

fn rerata(xs) {
  return total(xs) / len(xs)
}

let nilai = [80, 90, 75, 85, 95]

print("Nilai   :", nilai)
print("Jumlah  :", total(nilai))
print("Rerata  :", rerata(nilai))
print("Terendah:", min(nilai))
print("Tertinggi:", max(nilai))

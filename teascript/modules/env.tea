// Modul env TeaScript — baca file .env dan variabel lingkungan.
// Dipakai: import env
//
// Ditulis murni TeaScript di atas pyimport("os") + pyimport("pathlib"),
// jadi tidak butuh paket Python tambahan (beda dengan python-dotenv).

let os = pyimport("os")
let pathlib = pyimport("pathlib")
let Path = pathlib.Path

// Nilai yang sudah dimuat dari file, dipakai load() berikutnya.
let _tersimpan = {}

// --- util internal ---

fn _adalah_path(p) {
  return type(p) == "str"
}

// Ambil isi file; kembalikan nil kalau file tidak ada.
fn _baca_file(p) {
  let path = Path(p)
  if not path.exists() { return nil }
  return path.read_text()
}

// Cari file .env mulai dari cwd lalu naik ke folder induk.
// Kembalikan path absolut, atau nil kalau tidak ketemu.
fn _cari(nama) {
  let now = Path(os.getcwd()).resolve()
  let sekarang = str(now)
  while true {
    let kandidat = os.path.join(sekarang, nama)
    if Path(kandidat).exists() { return kandidat }
    let induk = str(Path(sekarang).parent)
    if induk == sekarang { return nil }
    sekarang = induk
  }
  return nil
}

// Buang komentar dan spasi di ujung. String yang diapit kutip dibiarkan.
fn _bersihkan(baris) {
  let s = trim(baris)
  if len(s) == 0 { return "" }
  if starts_with_teks(s, "#") { return "" }
  // komentar di tengah baris (hanya kalau ada spasi sebelumnya)
  let idx = _cari_pagar(s)
  if idx >= 0 { s = trim(s[0:idx]) }
  return s
}

// Cari '#' yang bukan bagian dari nilai berkutip.
fn _cari_pagar(s) {
  let dalam = ""
  for i in range(len(s)) {
    let c = s[i]
    if c == "\"" or c == "'" {
      dalam = dalam == c ? "" : (dalam == "" ? c : dalam)
    }
    if c == "#" and dalam == "" {
      if i == 0 or s[i - 1] == " " { return i }
    }
  }
  return -1
}

fn starts_with_teks(s, awalan) {
  if len(awalan) > len(s) { return false }
  return s[0:len(awalan)] == awalan
}

// Hapus kutip pembuka/penutup kalau ada.
fn _buang_kutip(v) {
  if len(v) >= 2 {
    let awal = v[0]
    let akhir = v[len(v) - 1]
    if (awal == "\"" and akhir == "\"") or (awal == "'" and akhir == "'") {
      return v[1:len(v) - 1]
    }
  }
  return v
}

// Ganti ${NAMA} atau $NAMA dengan nilai dari peta.
fn _interpolasi(v, peta) {
  let out = ""
  let i = 0
  while i < len(v) {
    let c = v[i]
    if c != "$" {
      out += c
      i += 1
      continue
    }
    // ${
    if i + 1 < len(v) and v[i + 1] == "{" {
      let tutup = _cari_karakter(v, "}", i + 2)
      if tutup >= 0 {
        let nama = v[i + 2:tutup]
        out += _nilai(nama, peta)
        i = tutup + 1
        continue
      }
    }
    // $NAMA (huruf/angka/underscore)
    let j = i + 1
    while j < len(v) and _valid_nama(v[j]) {
      j += 1
    }
    if j == i + 1 {
      out += c
      i += 1
      continue
    }
    out += _nilai(v[i + 1:j], peta)
    i = j
  }
  return out
}

fn _cari_karakter(s, cari, dari) {
  for i in range(dari, len(s)) {
    if s[i] == cari { return i }
  }
  return -1
}

fn _valid_nama(c) {
  let kode = c
  return (kode >= "a" and kode <= "z") or (kode >= "A" and kode <= "Z") or
         (kode >= "0" and kode <= "9") or kode == "_"
}

fn _nilai(nama, peta) {
  if nama in peta { return peta[nama] }
  let dari_os = os.environ.get(nama)
  return dari_os == nil ? "" : dari_os
}

// --- API publik ---

// Uraikan isi .env jadi dictionary (tanpa menyentuh os.environ).
fn parse(isi) {
  let hasil = {}
  for baris in split(isi, "\n") {
    let s = _bersihkan(baris)
    if len(s) == 0 { continue }
    let eq = _cari_karakter(s, "=", 0)
    if eq < 0 { continue }
    let kunci = trim(s[0:eq])
    if starts_with_teks(kunci, "export ") {
      kunci = trim(kunci[7:])
    }
    if len(kunci) == 0 { continue }
    let nilai = trim(s[eq + 1:])
    nilai = _buang_kutip(nilai)
    hasil[kunci] = _interpolasi(nilai, hasil)
  }
  return hasil
}

// Muat file .env. path opsional; kalau nil dicari otomatis dari cwd.
// override = true menimpa variabel yang sudah ada di OS.
fn load(path = nil, override = false) {
  let p = path
  if p == nil { p = _cari(".env") }
  if p == nil { return false }

  let isi = _baca_file(p)
  if isi == nil { return false }

  let peta = parse(isi)
  let jumlah = 0
  for kunci in keys(peta) {
    _tersimpan[kunci] = peta[kunci]
    if override or os.environ.get(kunci) == nil {
      os.environ[kunci] = peta[kunci]
      jumlah += 1
    }
  }
  return jumlah > 0
}

// Ambil variabel: dari OS, lalu dari hasil load(), lalu default.
fn get(nama, default = nil) {
  let v = getenv(nama)
  if v != nil { return v }
  if nama in _tersimpan { return _tersimpan[nama] }
  return default
}

// Sama seperti get, tapi error kalau tidak ada.
fn wajib(nama) {
  let v = get(nama, nil)
  if v == nil {
    error("env: variabel '" + nama + "' tidak ada")
  }
  return v
}

// Ubah nilai jadi angka; nil kalau bukan angka.
fn get_num(nama, default = nil) {
  let v = get(nama, nil)
  if v == nil { return default }
  let n = num(v)
  return n
}

// Ubah nilai jadi boolean: 1/true/yes/on (tanpa peduli huruf besar).
fn get_bool(nama, default = nil) {
  let v = get(nama, nil)
  if v == nil { return default }
  let s = lower(trim(v))
  if s == "1" or s == "true" or s == "yes" or s == "on" { return true }
  if s == "0" or s == "false" or s == "no" or s == "off" { return false }
  return default
}

// Semua variabel yang sudah dimuat dari file (tanpa isi OS).
fn semua() {
  return _tersimpan
}

// Kosongkan hasil load() (tidak mengubah os.environ).
fn reset() {
  _tersimpan = {}
}
